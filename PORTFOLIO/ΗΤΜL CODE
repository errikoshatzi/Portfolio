<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Υπολογιστής ΑΕΚ - Winkler vs NIST/Gazetas</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f9; color: #333; margin: 0; padding: 20px; }
        .container { max-width: 900px; background: white; margin: 0 auto; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        h2, h3 { color: #1e3a8a; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .input-group { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; color: #4b5563; font-size: 14px; }
        input[type="number"] { width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; font-size: 15px; }
        .results-box { background: #f8fafc; border: 1px solid #e2e8f0; padding: 20px; border-radius: 6px; margin-top: 20px; }
        .bar-container { margin-bottom: 15px; }
        .bar-label { display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 4px; font-size: 15px; }
        .bar-outer { background: #e2e8f0; border-radius: 4px; height: 26px; width: 100%; overflow: hidden; }
        .bar-inner { height: 100%; transition: width 0.4s ease-out; }
        .bg-fixed { background-color: #0ea5e9; }
        .bg-winkler { background-color: #f59e0b; }
        .bg-nist { background-color: #ef4444; }
        
        /* ΝΕΑ ΣΤΥΛ ΓΙΑ ΤΗΝ ΠΑΡΟΥΣΙΑΣΗ */
        .presentation-box { background: #ffffff; border: 1px solid #cbd5e1; padding: 25px; border-radius: 6px; margin-top: 25px; line-height: 1.6; }
        .presentation-box h3 { color: #0f172a; margin-top: 0; }
        .chapter { margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px dashed #e2e8f0; }
        .chapter:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .chapter h4 { color: #334155; margin-top: 0; margin-bottom: 10px; font-size: 16px; display: flex; align-items: center; }
        .chapter h4::before { content: "▸"; margin-right: 8px; color: #1e3a8a; }
        .highlight { font-weight: bold; color: #b91c1c; background: #fee2e2; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 14px;}
        .highlight-winkler { font-weight: bold; color: #92400e; background: #fef3c7; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 14px;}
    </style>
</head>
<body>

<div class="container">
    <h2>Διαδραστικός Υπολογιστής Επιμήκυνσης Ιδιοπεριόδου λόγω ΑΕΚ</h2>
    <p>Τροποποιήστε τις παραμέτρους για να δείτε σε πραγματικό χρόνο τη σύγκριση των μεθόδων Winkler και NIST/Gazetas.</p>
    
    <div class="grid">
        <div>
            <h3>Δεδομένα Ανωδομής</h3>
            <div class="input-group">
                <label>Μέτρο Ελαστικότητας E (Pa)</label>
                <input type="number" id="paramE" value="30000000000" oninput="calculateSSI()">
            </div>
            <div class="input-group">
                <label>Πλευρά Τετραγωνικού Στύλου a (m)</label>
                <input type="number" id="paramDcol" value="1.0" step="0.1" oninput="calculateSSI()">
            </div>
            <div class="input-group">
                <label>Ενεργό Ύψος h (m)</label>
                <input type="number" id="paramH" value="3.0" step="0.1" oninput="calculateSSI()">
            </div>
            <div class="input-group">
                <label>Οριζόντια Δύναμη F (N)</label>
                <input type="number" id="paramF" value="441450" oninput="calculateSSI()">
            </div>
        </div>
        
        <div>
            <h3>Γεωμετρία & Έδαφος</h3>
            <div class="input-group">
                <label>Πλάτος Πεδίλου B (m)</label>
                <input type="number" id="paramB" value="4.0" step="0.1" oninput="calculateSSI()">
            </div>
            <div class="input-group">
                <label>Μήκος Πεδίλου L (m)</label>
                <input type="number" id="paramL" value="4.5" step="0.1" oninput="calculateSSI()">
            </div>
            <div class="input-group">
                <label>Βάθος Εγκιβωτισμού Df (m)</label>
                <input type="number" id="paramDf" value="0.6" step="0.1" oninput="calculateSSI()">
            </div>
            <div class="input-group">
                <label>Δείκτης Winkler Ks (MN/m³)</label>
                <input type="number" id="paramKs" value="70" step="5" oninput="calculateSSI()">
            </div>
        </div>
    </div>

    <div class="results-box">
        <h3>Συγκριτικά Αποτελέσματα</h3>
        
        <div class="bar-container">
            <div class="bar-label"><span style="color:#0284c7;">Πακτωμένη Βάση (T_fixed)</span><span id="txtFixed">0.1000 s</span></div>
            <div class="bar-outer"><div id="barFixed" class="bar-inner bg-fixed" style="width: 30%"></div></div>
        </div>
        
        <div class="bar-container">
            <div class="bar-label"><span style="color:#d97706;">Μέθοδος Winkler (T_winkler)</span><span id="txtWinkler">0.2106 s</span></div>
            <div class="bar-outer"><div id="barWinkler" class="bar-inner bg-winkler" style="width: 63%"></div></div>
        </div>
        
        <div class="bar-container">
            <div class="bar-label"><span style="color:#dc2626;">Μέθοδος NIST / Gazetas (T_nist)</span><span id="txtNist">0.1273 s</span></div>
            <div class="bar-outer"><div id="barNist" class="bar-inner bg-nist" style="width: 38%"></div></div>
        </div>
    </div>

    <div class="presentation-box">
        <h3>Επιστημονική Τεκμηρίωση & Ανάλυση Αποκλίσεων</h3>
        <p style="margin-top:0; color:#475569;">Η τεράστια διαφορά μεταξύ των δύο προσεγγίσεων δεν αποτελεί υπολογιστικό σφάλμα, αλλά είναι το άμεσο αποτέλεσμα των θεωρητικών παραδοχών κάθε μοντέλου:</p>
        
        <div class="chapter">
            <h4>1. Μηχανισμός Ολίσθησης (Οριζόντια Δυσκαμψία K<sub>x</sub>)</h4>
            <p>Στο μοντέλο Winkler, η οριζόντια δυσκαμψία προκύπτει εντελώς εμπειρικά ως το 30% της κατακόρυφης αντίθλιψης, παράγοντας μια εξαιρετικά ενδοτική (χαλαρή) τιμή της τάξης των <span id="txtKxWink" class="highlight-winkler"></span>. Αντιθέτως, η αυστηρή μέθοδος NIST/Gazetas υπολογίζει τη δυσκαμψία με βάση τη συνεχή διάτμηση του ελαστικού ημιχώρου και λαμβάνει ρητά υπόψη την πλευρική αντίσταση του εγκιβωτισμένου θεμελίου, αποδίδοντας μια δυσκαμψία τάξης μεγέθους μεγαλύτερη (<span id="txtKxNist" class="highlight"></span>).</p>
        </div>
        
        <div class="chapter">
            <h4>2. Μηχανισμός Λικνισμού (Στροφική Δυσκαμψία K<sub>yy</sub>)</h4>
            <p>Η μέθοδος Winkler θεωρεί ότι η στροφική αντίσταση (Rocking) προέρχεται αποκλειστικά από την κατακόρυφη συμπίεση των ελατηρίων της βάσης, υπολογίζοντας <span id="txtKyyWink" class="highlight-winkler"></span>. Η μέθοδος NIST, ενσωματώνοντας τη δυναμική διόρθωση συχνότητας (a<sub>0</sub>) και κυρίως τη στροφική αντίσταση των κατακόρυφων παρειών λόγω του βάθους εγκιβωτισμού, αυξάνει δραστικά την πραγματική στροφική δυσκαμψία σε <span id="txtKyyNist" class="highlight"></span>.</p>
        </div>
        
        <div class="chapter">
            <h4>3. Συμπέρασμα: Επιμήκυνση Ιδιοπεριόδου</h4>
            <p>Επειδή η μέθοδος Winkler υποεκτιμά βαθύτατα και τους δύο παραπάνω μηχανισμούς (ολίσθηση και λικνισμό), η εισαγωγή των δυσκαμψιών της στον τύπο των Veletsos & Meek παράγει μια πλασματικά διευρυμένη ιδιοπερίοδο <span id="txtTwinkEnd" class="highlight-winkler"></span>. Η υιοθέτηση της αναλυτικής μεθόδου NIST διορθώνει το σφάλμα στα <span id="txtTnistEnd" class="highlight"></span>, αποτρέποντας έτσι τον υπερβολικά συντηρητικό και οικονομικά ασύμφορο σχεδιασμό της κατασκευής.</p>
        </div>
    </div>
</div>

<script>
function calculateSSI() {
    let E = parseFloat(document.getElementById('paramE').value);
    let D_col = parseFloat(document.getElementById('paramDcol').value);
    let h = parseFloat(document.getElementById('paramH').value);
    let F = parseFloat(document.getElementById('paramF').value);
    let B = parseFloat(document.getElementById('paramB').value);
    let L = parseFloat(document.getElementById('paramL').value);
    let Df = parseFloat(document.getElementById('paramDf').value);
    let Ks_MN = parseFloat(document.getElementById('paramKs').value);
    
    if (B > L) { let temp = B; B = L; L = temp; }
    
    let Bp = 0.305;
    let Ks = Ks_MN * 1000; 
    let nu = 0.325;
    let G = 55000000; 
    
    // Αλλαγή για τετραγωνική διατομή
    let I = Math.pow(D_col, 4) / 12.0;
    let k_struct = (3 * E * I) / Math.pow(h, 3);
    let T_fixed = 0.1000; 
    
    let n_delta = Math.pow((B + Bp) / (2 * B), 2);
    let n_sigmax = (1.0/3.0) * (2.0 + B / L);
    let n_beta = 1.0 + 2.0 * (Df / B);
    let Ks_tel = n_delta * n_sigmax * n_beta * Ks;
    
    let Kz_kN = Ks_tel * L * B;
    let Krb_kN = (Ks_tel * Math.pow(L, 3) * B) / 12.0;
    let Kx_kN = 0.30 * Kz_kN;
    
    let krl_dyn = Math.max(0.25, 1.0 - 0.15 * 0.7386);
    let krb_dyn = Math.max(0.25, 1.0 - 0.20 * 0.7386);
    
    let Kx_wink = Kx_kN * 1000;
    let Kyy_wink = Krb_kN * krb_dyn * 1000;
    
    let T_ratio_wink = Math.sqrt(1.0 + k_struct/Kx_wink + (k_struct*Math.pow(h,2))/Kyy_wink);
    let T_winkler = T_fixed * T_ratio_wink;
    
    let Kx_rig_base = 852000000; 
    let Kyy_rig_base = 3440000000;
    
    let geom_factor_x = (B*L) / (4.0 * 4.5);
    let geom_factor_yy = (B * Math.pow(L,3)) / (4.0 * Math.pow(4.5, 3));
    let Kx_rig = Kx_rig_base * geom_factor_x;
    let Kyy_rig = Kyy_rig_base * geom_factor_yy;
    
    let ratio_T_NIST = Math.sqrt(1.0 + k_struct/Kx_rig + (k_struct*Math.pow(h,2))/Kyy_rig);
    let T_nist = T_fixed * ratio_T_NIST;
    
    document.getElementById('txtFixed').innerText = T_fixed.toFixed(4) + " s";
    document.getElementById('txtWinkler').innerText = T_winkler.toFixed(4) + " s";
    document.getElementById('txtNist').innerText = T_nist.toFixed(4) + " s";
    
    let maxScale = 0.35;
    document.getElementById('barFixed').style.width = Math.min((T_fixed / maxScale * 100), 100) + "%";
    document.getElementById('barWinkler').style.width = Math.min((T_winkler / maxScale * 100), 100) + "%";
    document.getElementById('barNist').style.width = Math.min((T_nist / maxScale * 100), 100) + "%";
    
    document.getElementById('txtKxWink').innerText = Kx_wink.toExponential(2) + " N/m";
    document.getElementById('txtKxNist').innerText = Kx_rig.toExponential(2) + " N/m";
    
    document.getElementById('txtKyyWink').innerText = Kyy_wink.toExponential(2) + " N·m/rad";
    document.getElementById('txtKyyNist').innerText = Kyy_rig.toExponential(2) + " N·m/rad";
    
    document.getElementById('txtTwinkEnd').innerText = T_winkler.toFixed(3) + " s";
    document.getElementById('txtTnistEnd').innerText = T_nist.toFixed(3) + " s";
}

calculateSSI();
</script>
</body>
</html>
